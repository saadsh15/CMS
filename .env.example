# PostgreSQL connection (point to your Dokploy PostgreSQL service)
POSTGRES_HOST=portfolio-db
POSTGRES_PORT=5432
POSTGRES_DB=portfolio_cms
POSTGRES_USER=drupal
POSTGRES_PASSWORD=change_me_strong_password

# Initial Drupal Admin Account (created on first run)
DRUPAL_SITE_NAME=Saad Shafique Studio
DRUPAL_ADMIN_USER=admin
DRUPAL_ADMIN_PASS=change_me_strong_admin_password
DRUPAL_ADMIN_EMAIL=admin@yourdomain.com

# Public CMS URL & Optional Extra Trusted Hostnames (comma-separated)
PUBLIC_CMS_URL=https://cms.yourdomain.com
TRUSTED_HOSTS=cms.yourdomain.com,portfolio-cms

# Next.js Revalidation Webhook
NEXT_INTERNAL_URL=https://yourdomain.com
REVALIDATE_SECRET=change_me_shared_secret
