<?php

/**
 * @file
 * Creates reusable Paragraph website-building blocks on module install.
 */

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\paragraphs\Entity\ParagraphsType;

/**
 * Helper to create a Paragraph type if it does not exist.
 */
function _portfolio_builder_ensure_paragraph_type(string $id, string $label, string $description): void {
  if (!ParagraphsType::load($id)) {
    ParagraphsType::create([
      'id' => $id,
      'label' => $label,
      'description' => $description,
    ])->save();
  }
}

/**
 * Helper to ensure field storage, field instance, and form widget on a paragraph.
 */
function _portfolio_builder_ensure_field(
  string $bundle,
  string $field_name,
  string $type,
  string $label,
  array $storage_settings = [],
  array $field_settings = [],
  int $cardinality = 1,
  string $widget = '',
  int $weight = 0,
  string $description = '',
  bool $required = FALSE,
): void {
  if (!FieldStorageConfig::loadByName('paragraph', $field_name)) {
    FieldStorageConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'paragraph',
      'type' => $type,
      'cardinality' => $cardinality,
      'settings' => $storage_settings,
    ])->save();
  }

  if (!FieldConfig::loadByName('paragraph', $bundle, $field_name)) {
    FieldConfig::create([
      'field_name' => $field_name,
      'entity_type' => 'paragraph',
      'bundle' => $bundle,
      'label' => $label,
      'description' => $description,
      'required' => $required,
      'settings' => $field_settings,
    ])->save();
  }

  $form_display = EntityFormDisplay::load("paragraph.{$bundle}.default");
  if (!$form_display) {
    $form_display = EntityFormDisplay::create([
      'targetEntityType' => 'paragraph',
      'bundle' => $bundle,
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }

  $default_widgets = [
    'string' => 'string_textfield',
    'string_long' => 'string_textarea',
    'text_long' => 'text_textarea',
    'integer' => 'number',
    'boolean' => 'boolean_checkbox',
    'list_string' => 'options_select',
    'entity_reference_revisions' => 'paragraphs',
  ];

  $form_display->setComponent($field_name, [
    'type' => $widget ?: ($default_widgets[$type] ?? 'string_textfield'),
    'weight' => $weight,
  ])->save();
}

/**
 * Helper to attach reusable background controls (Image, Stock, Video, Canvas) to a paragraph bundle.
 */
function _portfolio_builder_ensure_background_fields(string $bundle, int $start_weight = 10): void {
  _portfolio_builder_ensure_field($bundle, 'field_bg_type', 'list_string', 'Background Mode', [
    'allowed_values' => [
      'image' => 'Background Image / Stock Photo',
      'video' => 'Looping Ambient Video (MP4 / WebM)',
      'ambient_canvas' => 'Living Architectural Canvas',
      'architectural_topo' => 'Architectural Grid & Contours',
      'none' => 'Pure Matte Surface',
    ],
  ], [], 1, 'options_select', $start_weight);
  _portfolio_builder_ensure_field(
    $bundle,
    'field_bg_media_url',
    'string',
    'Background Image or Video URL',
    [],
    [],
    1,
    'string_textfield',
    $start_weight + 1,
    'Local path (e.g. /images/backgrounds/hero-architectural.png or /videos/loop.mp4) or external stock URL.'
  );
  _portfolio_builder_ensure_field(
    $bundle,
    'field_bg_poster_url',
    'string',
    'Video Poster Image URL (optional)',
    [],
    [],
    1,
    'string_textfield',
    $start_weight + 2,
    'Displayed while looping background video loads.'
  );
  _portfolio_builder_ensure_field($bundle, 'field_bg_overlay', 'list_string', 'Overlay Contrast Scrim', [
    'allowed_values' => [
      'subtle' => 'Subtle',
      'medium' => 'Balanced (Recommended)',
      'heavy' => 'High Contrast',
      'editorial' => 'Dark Editorial',
    ],
  ], [], 1, 'options_select', $start_weight + 3);
}

